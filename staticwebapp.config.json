{
  "trailingSlash": "auto",
  "routes": [
    {
      "route": "/aviation-lock-screen-widget*",
      "redirect": "/aviation-home-screen-widget/",
      "statusCode": 301
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/assets/*",
      "/css/*",
      "/config.js",
      "/robots.txt",
      "/sitemap.xml",
      "/*.{png,jpg,jpeg,gif,webp,ico,svg,css,js,txt,xml}"
    ]
  }
}
