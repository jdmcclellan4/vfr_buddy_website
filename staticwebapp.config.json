{
  "trailingSlash": "auto",
  "routes": [
    {
      "route": "/aviation-lock-screen-widget",
      "redirect": "/aviation-home-screen-widget/",
      "statusCode": 301
    },
    {
      "route": "/aviation-lock-screen-widget/",
      "redirect": "/aviation-home-screen-widget/",
      "statusCode": 301
    },
    {
      "route": "/aviation-lock-screen-widget/*",
      "redirect": "/aviation-home-screen-widget/",
      "statusCode": 301
    }
  ],
  "responseOverrides": {
    "404": {
      "rewrite": "/index.html"
    }
  }
}
